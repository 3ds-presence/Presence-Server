NGINX_PORT=8080
RUST_LOG=info
CLIENT_ID=...
CLIENT_SECRET=...
BASE_URL=...
REDIRECT_URI=${BASE_URL}
ASSETS_BASE_URL=${BASE_URL}/imgs/
SCRIPTS_DIR=/app/scripts/
MII_GENERATOR_URL = ${BASE_URL}
MII_GENERATOR_SERVER=${MII_GENERATOR_URL}/miis/image.png?data=

# Master key (AES-256) used to encrypt tokens/AES keys at rest in the DB.
# Generate one with: openssl rand -hex 32  (64 hex chars, required)
MASTER_KEY=...

# Cloudflare Turnstile (optional - leave empty to disable the bot check).
# Get a site key + secret key from https://dash.cloudflare.com/ - Turnstile.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# Docker logs rotation settings
TZ=Europe/Paris
LOG_RETENTION_DAYS=90
# Archive a running log as soon as it reaches this size (bytes).
# 15728640 = 15 MiB. Set to 0 to disable mid-day rotation.
LOG_MAX_SIZE_BYTES=15728640
